m/movie1.mp4", "Price": "6.80", "Discount": null, "Rating": "NC-17", "Uploaded_on": "2020-12-28T02:08:26.699Z", "slug": "Cuddling", "Genre": [7]}}, {"model": "movie_platform.movie", "pk": 7, "fields": {"Title": "Crow In My Dreams", "Summary": "This is an epic about depression. The story is about a barbarian who is dependent on medication. It starts in a grocery store in a port city. The crux of the story involves someone getting drunk. The role of technology in the modern world plays a major part in the story.", "Image": "posters/7.png", "Link": "https://movierium-app.s3-eu-west-1.amazonaws.com/movie1.mp4", "Price": "8.00", "Discount": null, "Rating": "PG-13", "Uploaded_on": "2020-12-28T02:09:10.752Z", "slug": "Crow-In-My-Dreams", "Genre": [4, 5]}}, {"model": "movie_platform.movie", "pk": 8, "fields": {"Title": "Ghosts In The Fog", "Summary": "The story is about a hacker. It takes place in a military outpost. The crux of the story involves a murder. Archaeology versus respecting native cultures plays a major role in this story.", "Image": "posters/8.png", "Link": "https://movierium-app.s3-eu-west-1.amazonaws.com/movie1.mp4", "Price": "9.00", "Discount": null, "Rating": "PG-13", "Uploaded_on": "2020-12-28T02:10:15.853Z", "slug": "Ghosts-In-The-Fog", "Genre": [4, 7]}}, {"model": "movie_platform.movie", "pk": 9, "fields": {"Title": "Prize Of Hell", "Summary": "This is a tale about friendship and how one man can make a difference. The story is about an eccentric teacher who is constantly annoyed by an investor. It takes place in a crypt. A magical accident plays an important role.", "Image": "posters/9.png", "Link": "https://movierium-app.s3-eu-west-1.amazonaws.com/movie1.mp4", "Price": "7.90", "Discount": null, "Rating": "R", "Uploaded_on": "2020-12-28T02:11:49.281Z", "slug": "Prize-Of-Hell", "Genre": [2, 6]}}, {"model": "movie_platform.movie", "pk": 10, "fields": {"Title": "Age In My Sins", "Summary": "The story is about a librarian who is constantly opposing a bullying video game programmer. It takes place in a town in Africa. Technology getting out of hand is a major issue of the story.", "Image": "posters/10.png", "Link": "https://movierium-app.s3-eu-west-1.amazonaws.com/movie1.mp4", "Price": "8.50", "Discount": null, "Rating": "PG-13", "Uploaded_on": "2020-12-28T02:12:34.683Z", "slug": "Age-In-My-Sins", "Genre": [1, 4]}}, {"model": "movie_platform.movie", "pk": 11, "fields": {"Title": "Celebrate My Life", "Summary": "This is a drama/horror with an emphasis on taking control of one's life. The story is about an arch-mage who hates a focused midwife. It takes place in a marketplace in a colony. International crime plays a major role in this story.", "Image": "posters/11.png", "Link": "https://movierium-app.s3-eu-west-1.amazonaws.com/movie1.mp4", "Price": "8.00", "Discount": null, "Rating": "NC-17", "Uploaded_on": "2020-12-28T02:59:20.994Z", "slug": "Celebrate-My-Life", "Genre": [7]}}, {"model": "movie_platform.movie", "pk": 12, "fields": {"Title": "Women And Women", "Summary": "Young, available and good-looking, an unlikely relationship starts to blossom for the main character when they are introduced to a charming stranger. Soon becoming smitten with the love interest, the main character gives up on the idea of love when another person with much better chances than the main character shows up and results in animosity among the all those involved, and some who aren't.", "Image": "posters/12.png", "Link": "https://movierium-app.s3-eu-west-1.amazonaws.com/movie1.mp4", "Price": "8.50", "Discount": null, "Rating": "R", "Uploaded_on": "2020-12-28T10:29:59.033Z", "slug": "women-and-women", "Genre": [3, 5]}}, {"model": "movie_platform.orderitem", "pk": 23, "fields": {"Customer": 1, "Movie": 7, "Quantity": 1, "Complete": true}}, {"model": "movie_platform.orderitem", "pk": 24, "fields": {"Customer": 1, "Movie": 8, "Quantity": 1, "Complete": true}}, {"model": "movie_platform.orderitem", "pk": 26, "fields": {"Customer": 1, "Movie": 10, "